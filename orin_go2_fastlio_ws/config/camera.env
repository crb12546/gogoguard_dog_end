# Camera backend used by every patrol, console, snapshot, and video action.
# Supported values: unitree_builtin, z1pro
GO2_CAMERA_SOURCE=unitree_builtin

# Unitree Go2 built-in front camera settings. Linux may rename the same port
# between eth0 and eth1 after a reboot, so resolve it by its stable MAC.
GO2_BUILTIN_CAMERA_INTERFACE=auto
GO2_BUILTIN_CAMERA_MAC=4c:bb:47:ab:e4:c2
GO2_BUILTIN_CAMERA_FPS=15
GO2_BUILTIN_CAMERA_BITRATE=4000000

# Z-1Pro settings are kept ready for switching back later.
Z1PRO_RTSP_URL=rtsp://192.168.144.108/
