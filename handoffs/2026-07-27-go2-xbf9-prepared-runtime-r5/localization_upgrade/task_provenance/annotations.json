  "category_semantics": {
    "stable_include": {
      "label_zh": "可信固定结构（需组合使用）",
      "role": "stable_layer_roi",
      "offline_map_action": "extract_to_stable_layer",
      "description_zh": "经过对象级圈选和人工复核的固定结构提示，不是一个离散定位点；定位必须组合多个方向和位置的结构。"
    },
    "dynamic_exclude": {
      "label_zh": "动态物体排除",
      "role": "static_map_exclude_roi",
      "offline_map_action": "exclude_from_cleaned_map",
      "description_zh": "车辆、行人或其他动态物体的对象级区域；批准后供离线地图处理生成新地图。"
    },
    "vegetation_exclude": {
      "label_zh": "树木植被排除",
      "role": "static_map_exclude_roi",
      "offline_map_action": "exclude_from_cleaned_map",
      "description_zh": "树冠、枝叶或随季节和风变化的植被区域；应使用带高度范围的 ROI，避免误删地面。"
    },
    "parking_exclude": {
      "label_zh": "停车区域排除",
      "role": "static_map_exclude_roi",
      "offline_map_action": "exclude_from_cleaned_map",
      "description_zh": "停放车辆经常变化的区域；应按具体对象或明确高度范围圈选。"
    },
    "low_confidence": {
      "label_zh": "低置信区域",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "人工判断置信度不足的复核提示，不自动修改离线地图。"
    },
    "repetitive_geometry": {
      "label_zh": "重复建筑结构",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "可能造成匹配歧义的重复结构提示，不自动修改离线地图。"
    },
    "ghosting": {
      "label_zh": "疑似重影/双墙",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "疑似重影或双墙的质量问题提示，不自动修改离线地图。"
    },
    "drift_suspect": {
      "label_zh": "疑似开始发散",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "疑似轨迹或建图开始发散的位置提示，不自动修改离线地图。"
    },
    "sparse": {
      "label_zh": "点云稀疏/空洞",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "点云稀疏或存在空洞的质量问题提示，不自动修改离线地图。"
    },
    "blind_zone": {
      "label_zh": "雷达盲区",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "疑似雷达盲区或遮挡区域提示，不自动修改离线地图。"
    },
    "manual_review": {
      "label_zh": "其他待复核",
      "role": "review_finding",
      "offline_map_action": "none",
      "description_zh": "没有归入其他类别的人工复核提示，不自动修改离线地图。"
    }
  },
  "safety": {
    "source_map_mutation": "forbidden",
    "mask_application_requires_preview": true,
    "filtered_map_requires_new_sha256": true,
    "approved_roi_required_for_map_action": true,
    "localization_constraint_notice_zh": "单根旗杆或单面墙不能独自约束 x、y、yaw 三自由度；只有经过对象级圈选与人工批准的多个固定结构组合，才能进入后续地图编译评估。"
